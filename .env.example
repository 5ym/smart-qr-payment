# --- Database -------------------------------------------------------------
# Path to the SQLite database file (created automatically).
DATABASE_URL=./data/sqp.db

# --- App ------------------------------------------------------------------
# Public base URL, used for verification links and Stripe return URLs.
PUBLIC_BASE_URL=http://localhost:5173

# --- Seed / admin ---------------------------------------------------------
ADMIN_EMAIL=admin@sqp.local
ADMIN_PASSWORD=adminpassword

# --- Email: Azure Communication Services (optional) -----------------------
# When unset, verification links are logged to the console instead of sent.
# Provide the connection string (endpoint + accesskey) OR the endpoint/key pair.
ACS_CONNECTION_STRING=
# ACS_ENDPOINT=https://<resource>.communication.azure.com
# ACS_ACCESS_KEY=<base64-access-key>
# Verified sender, e.g. DoNotReply@<guid>.azurecomm.net or your own domain.
ACS_SENDER_ADDRESS=

# --- Stripe (optional; card payment disabled when unset) ------------------
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Square POS (optional; used by the same-day purchase flow) ------------
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_CALLBACK_URL=http://localhost:5173/real/square
