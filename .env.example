# --- Database -------------------------------------------------------------
# Path to the SQLite database file (created automatically).
DATABASE_URL=./data/sqp.db

# --- App ------------------------------------------------------------------
# Public base URL, used for verification links and Stripe return URLs.
PUBLIC_BASE_URL=http://localhost:5173

# --- Seed / admin ---------------------------------------------------------
ADMIN_EMAIL=admin@sqp.local
ADMIN_PASSWORD=adminpassword

# --- Email (optional; falls back to console logging when unset) -----------
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@sqp.local

# --- Stripe (optional; card payment disabled when unset) ------------------
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Square POS (optional; used by the same-day purchase flow) ------------
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_CALLBACK_URL=http://localhost:5173/real/square
