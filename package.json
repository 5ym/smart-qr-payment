		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/qrcode": "^1.5.6",
		"daisyui": "^5.7.16",
		"html5-qrcode": "^2.3.8",
		"qrcode": "^1.5.4",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"stripe": "^22.5.0"
